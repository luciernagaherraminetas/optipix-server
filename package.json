{
  "name": "optipix",
  "version": "1.1.13",
  "main": "main.js",
  "productName": "OptiPix",
  "description": "Optimización inteligente de imágenes",
  "author": "Juan Manuel Alonso",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "nodemailer": "^8.0.7",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.optipix.app",
    "productName": "OptiPix",
    "directories": {
      "buildResources": "."
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.photography",
      "icon": "icon.icns"
    },

    "win": {
      "target": "nsis",
      "icon": "icons.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "sign": false,
      "window": {
        "width": 700,
        "height": 500
      },
      "contents": [
        {
          "x": 170,
          "y": 250
        },
        {
          "x": 500,
          "y": 250,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 335,
          "y": 90,
          "type": "file",
          "path": "manual/Manual-Instalacion-OptiPix.pdf"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "luciernagaherraminetas",
        "repo": "optipix-server"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "buildDependenciesFromSource": true,
    "asarUnpack": [
      "**/sharp/**/*",
      "**/@img/**/*",
      "**/*.node"
    ],
    "files": [
      "**/*",
      "manual/**/*",
      "manual_windows/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "extraResources": [
      {
        "from": "manual_windows",
        "to": "manual_windows"
      },
      {
        "from": "node_modules/sharp",
        "to": "node_modules/sharp"
      },
      {
        "from": "node_modules/@img",
        "to": "node_modules/@img"
      }
    ]
  }
}
